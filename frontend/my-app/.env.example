# 複製本檔為 .env.local 並填入值(.env.local 已被 gitignore;CRA 不會讀 .env.example)
# 註:純 `.env` 不在 gitignore 內,不要用;金鑰一律放 .env.local

# Supabase Dashboard → Project Settings → API → Project URL
REACT_APP_SUPABASE_URL=
# 同上頁面的 anon / publishable key(公開金鑰,不是 service_role!)
REACT_APP_SUPABASE_ANON_KEY=

# 後端 API 位置(不填時程式預設 http://localhost:8000)
# REACT_APP_API_URL=http://localhost:8000

# 訪客展示入口(登入頁「訪客展示(免登入)」按鈕)用的示範帳號 —
# 不填 = 按鈕不顯示。此帳密會嵌進前端 bundle(公開性質,刻意如此):
# 只用來放想給別人看的示範單字,別填你個人帳號。
REACT_APP_DEMO_EMAIL=
REACT_APP_DEMO_PASSWORD=
