# 複製本檔為 .env 並填入實際值;.env 已被 .gitignore 排除,切勿提交或分享
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-service-role-key>
GEMINI_API_KEY=<gemini-api-key>
# 選填:Gemini 模型名(預設 gemini-3.8-flash);舊模型被 Google 淘汰時改這裡即可
# GEMINI_MODEL=gemini-3.8-flash
# 選填:只有仍使用 legacy HS256 JWT secret 的專案才填(新專案預設非對稱簽章,走 JWKS 自動驗證,留空即可)
SUPABASE_JWT_SECRET=
# 選填:示範(訪客)帳號的 Supabase UUID。公開 demo 帳密時用來擋付費 AI 花費 ——
# 設了 = 該帳號 3 次/小時(跨 /words/fill 與 /tests/submit_definition 合計);
# 不設 = 整道閘門不生效(本機開發通常不設,才不會擋住維護示範字庫)。
# 值從 Supabase 後台 Authentication → Users 複製示範帳號那列的 id,不是 email。
# DEMO_USER_ID=00000000-0000-0000-0000-000000000000

